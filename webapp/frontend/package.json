{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Max Lange",
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/primum-mobile/aries",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "preview:smoke": "bash ./scripts/preview-smoke.sh",
    "typecheck": "tsc --noEmit",
    "test": "npm run style-check && npm run test:unit",
    "test:unit": "playwright test tests/calendar-auto.spec.ts tests/chart-launch-parent.spec.ts tests/help-shortcut-keys.spec.ts --reporter=line",
    "style-token-check": "node ./scripts/style-token-integrity.mjs",
    "style-token-inventory": "node ./scripts/style-token-integrity.mjs --write-inventory",
    "style-token-contract-test": "node --test ./scripts/style-token-contract.test.mjs",
    "wheel-render-style-contract-test": "node --test ./scripts/wheel-render-style-contract.test.mjs",
    "ephemeris-render-style-contract-test": "node --test ./scripts/ephemeris-render-style-contract.test.mjs",
    "style-state-check": "node --test ./scripts/style-state-contract.test.mjs",
    "style-check": "npm run style-token-check && npm run style-token-contract-test && npm run wheel-render-style-contract-test && npm run ephemeris-render-style-contract-test && npm run style-state-check",
    "prebuild": "npm run style-check",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.8.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^3.0.6",
    "shadcn": "^4.4.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
