    "renderer-style-contract": "node ./scripts/generate-renderer-style-contract.mjs",
    "renderer-style-contract-check": "node ./scripts/generate-renderer-style-contract.mjs --check",
    "style-profile-catalog": "node ./scripts/generate-style-profile-catalog.mjs",
    "style-profile-catalog-check": "node ./scripts/generate-style-profile-catalog.mjs --check",
    "style-literal-contract-test": "node --test ./scripts/style-literal-contract.test.mjs",
    "layout-chrome-contract-test": "node --test ./scripts/layout-chrome-contract.test.mjs",
    "style-token-contract-test": "node --test ./scripts/style-token-contract.test.mjs",
