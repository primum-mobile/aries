    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "colorjs.io": "^0.7.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "^3.0.6",
    "shadcn": "^4.4.0",
