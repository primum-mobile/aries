    "typecheck": "tsc --noEmit",
    "test": "npm run style-check && npm run test:unit",
    "test:unit": "playwright test tests/calendar-auto.spec.ts tests/chart-launch-parent.spec.ts tests/chart-navbar-localization.spec.ts tests/help-shortcut-keys.spec.ts --reporter=line",
    "style-token-check": "node ./scripts/style-token-integrity.mjs",
