    "wheel-style-scene-contract-test": "node --test ./scripts/wheel-style-scene-contract.test.mjs",
    "style-lab-integration-contract-test": "node --test ./scripts/style-lab-integration-contract.test.mjs",
    "ephemeris-render-style-contract-test": "node --test ./scripts/ephemeris-render-style-contract.test.mjs",
    "square-render-style-contract-test": "node --test ./scripts/square-render-style-contract.test.mjs",
    "sphere-render-style-contract-test": "node --test ./scripts/sphere-render-style-contract.test.mjs",
    "strip-render-style-contract-test": "node --test ./scripts/strip-render-style-contract.test.mjs",
    "mundane-render-style-contract-test": "node --test ./scripts/mundane-render-style-contract.test.mjs",
    "astrolabe-render-style-contract-test": "node --test ./scripts/astrolabe-render-style-contract.test.mjs",
    "astrocart-style-contract-test": "node --test ./scripts/astrocart-style-contract.test.mjs",
    "palette-profile-contract-test": "node --test ./scripts/palette-profile-contract.test.mjs",
    "style-state-check": "node --test ./scripts/style-state-contract.test.mjs",
    "style-check": "npm run renderer-style-contract-check && npm run style-token-check && npm run style-profile-catalog-check && npm run style-literal-contract-test && npm run layout-chrome-contract-test && npm run style-token-contract-test && npm run wheel-render-style-contract-test && npm run wheel-authoring-unit-contract-test && npm run semantic-class-manifest-contract-test && npm run wheel-effect-style-contract-test && npm run wheel-style-scene-contract-test && npm run style-lab-integration-contract-test && npm run ephemeris-render-style-contract-test && npm run square-render-style-contract-test && npm run sphere-render-style-contract-test && npm run strip-render-style-contract-test && npm run mundane-render-style-contract-test && npm run astrolabe-render-style-contract-test && npm run astrocart-style-contract-test && npm run palette-profile-contract-test && npm run style-state-check",
